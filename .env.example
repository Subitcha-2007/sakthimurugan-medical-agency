# ========================================================
# SAKTHIMURUGAN MEDICAL AGENCY - PRODUCTION ENVIRONMENT VARIABLES
# ========================================================

# Server Port
PORT=5000

# Node Environment ('production' or 'development')
NODE_ENV=production

# MongoDB Production Connection URI (MongoDB Atlas or Cloud Database)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sakthimurugan_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@cluster.mongodb.net/sakthimurugan_db

# JSON Web Token Secret Key for Authentication
JWT_SECRET=your_super_secret_production_jwt_key_here

# Frontend Production Client Origin (for CORS allowed origins)
CLIENT_URL=https://sakthimurugan-medical.onrender.com

# Optional Delivery Helpline Overrides
AGENCY_PHONE=9994446994,9865730150
AGENCY_ADDRESS=50, 1st Floor, Kamaraj Street, Erode, Tamil Nadu - 638001
